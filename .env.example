# NLHE product-server configuration. No secrets in this template.
# Keys match `loadConfig` in src/config.ts exactly; unknown keys are ignored by
# parsing but startup rejects platform signing/session/RPC credential names.
# npm scripts do not load .env automatically; use:
#   node --env-file=.env dist/main.js   (or --import tsx src/main.ts for dev)

NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3001
# Must be an origin only (no path/query/fragment); non-loopback requires HTTPS.
PUBLIC_ORIGIN=http://localhost:3001
# PokerTools platform API (separate service: PostgreSQL + Redis + custody).
POKERTOOLS_API_URL=http://localhost:3000
# Scoped `competition:orchestrate` SERVICE credential. Secret; unset by default.
# POKERTOOLS_ORCHESTRATION_TOKEN=replace-with-scoped-platform-credential

# Dedicated product SQLite file (never a platform database URL); `:memory:` is
# rejected in production.
DATABASE_PATH=./data/product.sqlite

# Agent catalog (schema: src/product/catalog.ts; example: config/agents.example.json).
# It stores provider env-var NAMES (`keyEnv`), never values. Table-scoped agent
# credentials are issued fresh by the platform at runtime and are never configured.
AGENTS_CONFIG_PATH=./config/agents.json
# 0 disables all agent speech; 1 allows optional post-commit public chat.
AGENT_CHAT_ENABLED=0

# Operator-only administration/audit credential (>=32 chars). Secret; unset by default.
# PRODUCT_ADMIN_TOKEN=replace-with-at-least-32-character-admin-token

# Paid CHALLENGE is opt-in and fail-closed; enabling it requires the complete
# asset/entry/prize/sponsor tuple or startup fails.
CHALLENGE_ENABLED=0
# CHALLENGE_ASSET_ID=eip155:8453/erc20:0x...
# CHALLENGE_ENTRY_ATOMIC=10000000
# CHALLENGE_PRIZE_ATOMIC=20000000
# CHALLENGE_SPONSOR_PRINCIPAL_ID=principal-...

# Provider budgets and limits (integers; cost is micro-USD, 1 USD = 1,000,000).
# Provider cost is never converted to on-chain amounts or chips. A 0 cap admits
# only zero-priced calls.
MAX_PROVIDER_CONCURRENCY=4
MAX_PROVIDER_CALLS=100
MAX_COST_USD_MICRO=1000000
PER_CALL_TIMEOUT_MS=10000
OVERALL_RUNTIME_MS=600000
MAX_HANDS=100
